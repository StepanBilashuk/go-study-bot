# prepbot configuration — every variable the bot reads.
# In production this lives at /etc/prepbot.env (mode 600) via the systemd
# EnvironmentFile. Never commit real secrets.

# --- Required ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
DATABASE_URL=postgres://prepbot:CHANGE_ME@127.0.0.1:5432/prepbot
ANTHROPIC_API_KEY=            # required from Step 3 on (calibration, debrief, drills)

# --- Optional (defaults shown) ---
ANTHROPIC_MODEL=claude-opus-5 # any current model id; tuned without a rebuild
DATA_DIR=data                 # YAML definitions
PROMPTS_DIR=prompts           # Claude prompt templates

# Daily push: at PUSH_HOUR local time the bot sends /today to every user who
# has it enabled (default on; each user toggles with /push on|off).
PUSH_HOUR=8                   # 0-23, server local time

# Phase 5 gamification (XP, levels, streak, /stats). Off by default.
GAMIFICATION=false            # true|false
